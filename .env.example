PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taskflow?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_taskflow_prod
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Firebase Admin (backend) — get these from Firebase Console > Project Settings > Service Accounts
# Option A: paste the whole downloaded service-account JSON as one line
FIREBASE_SERVICE_ACCOUNT=
# Option B (alternative to A): individual fields instead of the JSON blob
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK (frontend) — get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
